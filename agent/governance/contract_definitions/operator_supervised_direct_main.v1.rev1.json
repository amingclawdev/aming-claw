  "rule_layer": {
    "stages": [
      {
        "stage_id": "route_gate",
        "description": "Observer binds the exact project, backlog, task, route, closed file fence, current worktree, base HEAD, target HEAD, and operator approval before graph or mutation evidence can advance.",
        "lines": [
          {
            "line_id": "observer_bind_direct_scope",
            "owner_role": "observer",
            "allowed_writer_roles": [
              "observer"
            ],
            "evidence_kind": "contract_binding",
            "description": "Source-backed Direct scope identity, route identity, immutable owned-files fence, worktree identity, commit boundary, test plan, and operator approval."
          }
        ]
      },
      {
        "stage_id": "graph_first",
        "description": "Observer resolves exact symbols and records DB-backed graph traces before the mutation exception is entered.",
        "lines": [
          {
            "line_id": "observer_graph_context",
            "owner_role": "observer",
            "allowed_writer_roles": [
              "observer"
            ],
            "evidence_kind": "graph_trace",
            "requires": [
              "observer_bind_direct_scope"
            ],
            "description": "Pre-implementation graph trace evidence bound to the exact route, task, file fence, target root, and pre-mutation world."
          }
        ]
      },
      {
        "stage_id": "pre_mutation",
        "description": "Observer enters the bounded operator-supervised Direct mutation only after route and graph-first proof.",
        "lines": [
          {
            "line_id": "observer_direct_implementation_exception",
            "owner_role": "observer",
            "allowed_writer_roles": [
              "observer"
            ],
            "evidence_kind": "observer_direct_implementation_exception",
            "requires": [
              "observer_graph_context"
            ],
            "description": "Server-admitted pre-mutation boundary proving tiny deterministic scope, clean file fence, explicit operator approval, and graph-first completion."
          }
        ]
      },
      {
        "stage_id": "implementation",
        "description": "Observer records the exact committed implementation and command-backed test evidence inside the closed Direct scope.",
        "lines": [
          {
            "line_id": "observer_implementation",
            "owner_role": "observer",
            "allowed_writer_roles": [
              "observer"
            ],
            "evidence_kind": "implementation",
            "requires": [
              "observer_direct_implementation_exception"
            ],
            "description": "Immutable implementation commit, exact changed-file subset, clean worktree proof, diff proof, and passing commit-bound test commands."
          }
        ]
      },
      {
        "stage_id": "qa_graph_context",
        "description": "Independent QA builds candidate graph context from the exact implementation commit.",
        "lines": [
          {
            "line_id": "qa_graph_context",
            "owner_role": "qa",
            "allowed_writer_roles": [
              "qa"
            ],
            "evidence_kind": "graph_trace",
            "requires": [
              "observer_implementation"
            ],
            "description": "QA-authored DB-backed graph traces for the exact candidate commit and target root; observer evidence cannot satisfy this line."
          }
        ]
      },
      {
        "stage_id": "qa",
        "description": "Independent QA returns exactly one PASS or NO-PASS verdict for the committed candidate.",
        "lines": [
          {
            "line_id": "qa_independent_verification",
            "owner_role": "qa",
            "allowed_writer_roles": [
              "qa"
            ],
            "evidence_kind": "independent_verification",
            "requires": [
              "qa_graph_context"
            ],
            "description": "Role-separated QA verdict with exact commit, structured test results, graph basis, and authenticated reviewer identity. NO-PASS terminalizes this source generation."
          }
        ]
      },
      {
        "stage_id": "reconcile",
        "description": "Observer reconciles and activates one full graph snapshot at the exact QA-accepted canonical HEAD.",
        "lines": [
          {
            "line_id": "observer_reconcile",
            "owner_role": "observer",
            "allowed_writer_roles": [
              "observer"
            ],
            "evidence_kind": "current_full_reconcile",
            "requires": [
              "qa_independent_verification"
            ],
            "description": "Canonical current-full reconcile evidence with exact commit ancestry, active snapshot identity, and QA-before-reconcile ordering."
          }
        ]
      },
      {
        "stage_id": "close_ready",
        "description": "Observer records close readiness only after accepted QA, runtime verification, and active current-HEAD full reconcile.",
        "lines": [
          {
            "line_id": "observer_close_ready",
            "owner_role": "observer",
            "allowed_writer_roles": [
              "observer"
            ],
            "evidence_kind": "close_ready",
            "requires": [
              "observer_reconcile"
            ],
            "description": "Exact closing HEAD, structured tests, live verification, graph reconcile proof, preflight result, and close-integrity evidence."
          }
        ]
      }
    ]
  },
