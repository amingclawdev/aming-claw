          }
        ]
      },
      {
        "stage_id": "row_fanout_planning",
        "description": "Bind one row-scoped mf_parallel successor plan per child backlog row.",
        "lines": [
          {
            "line_id": "observer_plan_row_successors",
            "owner_role": "observer",
            "allowed_writer_roles": ["observer"],
            "evidence_kind": "row_successor_plan",
            "required": true,
            "requires": ["observer_batch_preflight"],
            "description": "Each child retains its own Contract, RuntimeContext, file fence, QA and close authority."
          }
        ]
      },
      {
        "stage_id": "row_successor_dispatch",
        "description": "Enter the exact durable Batch generation and create the row-scoped successor bindings.",
        "lines": [
          {
            "line_id": "observer_bind_row_successors",
            "owner_role": "observer",
            "allowed_writer_roles": ["observer"],
            "evidence_kind": "row_successor_binding",
            "required": true,
            "requires": ["observer_plan_row_successors"],
            "description": "Use handle_project_mf_batch_parallel_enter; caller-supplied Batch authority is rejected."
          }
        ]
      },
      {
        "stage_id": "row_successor_tracking",
        "description": "Require every child candidate to finish its implementation and premerge QA boundary.",
        "lines": [
          {
            "line_id": "observer_bind_row_candidates",
            "owner_role": "observer",
            "allowed_writer_roles": ["observer"],
            "evidence_kind": "row_candidate_custody",
            "required": true,
            "requires": ["observer_bind_row_successors"],
            "description": "Candidate custody remains child-scoped and does not itself authorize canonical landing or parent close."
          }
        ]
      },
      {
        "stage_id": "batch_integration_epoch",
        "description": "Open or resume the one durable integration generation at the exact target ref and base.",
        "lines": [
          {
            "line_id": "observer_open_integration_epoch",
            "owner_role": "observer",
            "allowed_writer_roles": ["observer"],
            "evidence_kind": "integration_epoch",
            "required": true,
            "requires": ["observer_bind_row_candidates"],
            "description": "Use open_or_validate_integration_epoch; position skips, partial-head rebases and blind replay are refused."
          }
        ]
      },
      {
        "stage_id": "ordered_batch_merge",
        "description": "Land the immutable child candidates in the durable queue order.",
        "lines": [
          {
            "line_id": "observer_ordered_batch_merge",
            "owner_role": "observer",
            "allowed_writer_roles": ["observer"],
            "evidence_kind": "ordered_merge",
            "required": true,
            "requires": ["observer_open_integration_epoch"],
            "description": "Use the server-selected next merge queue item; a terminal source row is never mutated into retry authority."
          }
        ]
      },
      {
        "stage_id": "final_batch_reconcile",
        "description": "Run exactly one current-HEAD full reconcile for the completed integration generation.",
        "lines": [
          {
            "line_id": "observer_final_reconcile",
            "owner_role": "observer",
            "allowed_writer_roles": ["observer"],
            "evidence_kind": "current_full_reconcile",
            "required": true,
            "requires": ["observer_ordered_batch_merge"],
            "description": "The shared reconcile must bind the exact durable merged prefix and current canonical HEAD."
          }
        ]
      },
      {
        "stage_id": "batch_final_qa",
        "description": "Obtain fresh authenticated postmerge QA for every child against the shared reconciled HEAD.",
        "lines": [
          {
            "line_id": "qa_batch_postmerge_verification",
            "owner_role": "qa",
            "allowed_writer_roles": ["qa"],
            "evidence_kind": "batch_postmerge_independent_verification",
            "required": true,
            "requires": ["observer_final_reconcile"],
            "description": "QA NO-PASS cannot backedge this generation; it may authorize one fresh failed_qa_rework RuntimeContext followed by a new reconcile and fresh QA."
          }
        ]
      },
      {
        "stage_id": "protected_child_closures",
        "description": "Close child rows only through their own Contract and Gate authority.",
        "lines": [
          {
            "line_id": "observer_verify_protected_child_closures",
            "owner_role": "observer",
            "allowed_writer_roles": ["observer"],
            "evidence_kind": "protected_child_closures",
            "required": true,
            "requires": ["qa_batch_postmerge_verification"],
            "description": "Every child must be formally FIXED; child close never releases the parent integration freeze."
          }
        ]
      },
      {
        "stage_id": "atomic_coordination_epoch_close",
        "description": "Atomically close the coordination row and release the exact integration generation.",
        "lines": [
          {
            "line_id": "observer_atomic_coordination_epoch_close",
            "owner_role": "observer",
            "allowed_writer_roles": ["observer"],
            "evidence_kind": "close_ready",
            "required": true,
            "requires": ["observer_verify_protected_child_closures"],
            "description": "The existing parent close Gate derives authority from the durable Batch entry, terminal merge queue, child FIXED rows and exact close commit."
          }
        ]
      }
    ],
