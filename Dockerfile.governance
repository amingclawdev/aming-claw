FROM python:3.12-slim

WORKDIR /app

ARG AMING_CLAW_BUILD_COMMIT
RUN python -c "import re,sys; v='${AMING_CLAW_BUILD_COMMIT}'.strip().lower(); sys.exit(0 if re.fullmatch(r'[0-9a-f]{40}|[0-9a-f]{64}', v) else 'AMING_CLAW_BUILD_COMMIT must be an exact full Git commit')"
LABEL org.opencontainers.image.revision="${AMING_CLAW_BUILD_COMMIT}"

# Git is part of the governance runtime contract: bootstrap, version checks,
# graph snapshots, and merge previews all resolve immutable Git objects.
RUN apt-get update \
    && apt-get install --no-install-recommends -y git \
    && rm -rf /var/lib/apt/lists/*

# Install the same package metadata exposed by the host-side installer.
COPY pyproject.toml README.md LICENSE start_governance.py aming_claw.py ./
COPY agent/ agent/
RUN pip install --no-cache-dir ".[redis]"

# Preserve the chain-seal file for diagnostics. Release commits update chain
# authority through Git trailers; the image never edits this file at runtime.
COPY VERSION VERSION

RUN mkdir -p /app/shared-volume/codex-tasks/state/governance

EXPOSE 40000

ENV PYTHONUNBUFFERED=1 \
    AMING_CLAW_BUILD_COMMIT=${AMING_CLAW_BUILD_COMMIT} \
    GOVERNANCE_PORT=40000 \
    SHARED_VOLUME_PATH=/app/shared-volume

HEALTHCHECK --interval=5s --timeout=3s --start-period=10s --retries=12 \
  CMD python -c "import json,os,re,urllib.request; d=json.load(urllib.request.urlopen('http://127.0.0.1:40000/api/health',timeout=2)); c=os.environ.get('AMING_CLAW_BUILD_COMMIT',''); ok=bool(re.fullmatch(r'[0-9a-f]{40}|[0-9a-f]{64}',c)) and d.get('status')=='ok' and d.get('runtime_loaded_version')==c and d.get('worktree_head_version')==c and not d.get('runtime_stale',False); raise SystemExit(0 if ok else 1)"

CMD ["aming-governance"]
